# =============================================================================
# RO-ED AI Agent — Environment Configuration
# Copy this file: cp .env.example .env  then fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# JWT secret for token signing — generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# ADMIN USER (used on first DB init when no users exist)
# -----------------------------------------------------------------------------

ADMIN_DEFAULT_USERNAME=admin
# Leave blank → random pw printed on first init + admin must-change on login.
# Set explicitly to skip random+force-change.
ADMIN_INITIAL_PASSWORD=
# Legacy alias (still honored if set):
# ADMIN_DEFAULT_PASSWORD=

# CORS allowed origins (comma-separated). Lock to your domain in prod.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:9000,https://localhost

# DEV_MODE=1 allows JWT_SECRET_KEY fallback if blank. Empty for prod.
DEV_MODE=1

# Optional S3 backup target for pg-backup container
S3_BACKUP_BUCKET=

# -----------------------------------------------------------------------------
# DATABASE (Postgres) + QUEUE (Redis)
# Used by docker-compose to wire app + worker services together.
# -----------------------------------------------------------------------------

PG_PASSWORD=ro_ed_dev_pass
DATABASE_URL=postgresql+psycopg://ro_ed:ro_ed_dev_pass@postgres:5432/ro_ed
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# KEYCLOAK SSO (optional — leave empty to use local auth)
# Can also be configured via Settings page in the UI
# -----------------------------------------------------------------------------

# KEYCLOAK_REALM_URL=https://your-keycloak.example.com/realms/your-realm
# KEYCLOAK_CLIENT_ID=ro-ed-client
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_ADMIN_ROLE=admin
